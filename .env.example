PORT=8787

# Seed accounts (imported once into data/helper-users.json, then hashed).
# Staff can also create accounts from Home → Create account.
# email:password:Display Name,email2:password2:Name2
HELPER_USERS=jane@chicboutique.example:changeme:Jane

# Where created accounts and sign-in sessions are saved
# (helper-users.json, helper-sessions.json). On Render, attach a disk at this path
# (or set HELPER_DATA_DIR to the disk mount path, e.g. /var/data).
# HELPER_DATA_DIR=/opt/render/project/src/data

# Optional shared PIN for Create account. Leave empty to allow open signup.
# HELPER_SIGNUP_CODE=

# Set to 1 to hide Create account.
# HELPER_SIGNUP_DISABLED=

# Live vs practice BridalLive API (production = app.bridallive.com).
BL_ENVIRONMENT=production

# BridalLive Retailer ID + API key per location — stay on the server.
BL_WP_RETAILER_ID=
BL_WP_API_KEY=
BL_PK_RETAILER_ID=
BL_PK_API_KEY=
